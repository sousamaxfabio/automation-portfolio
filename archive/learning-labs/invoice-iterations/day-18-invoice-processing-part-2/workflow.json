    {
      "parameters": {
        "jsCode": "const data = $json.output ?? $json;\nconst issues = [];\n\nconst requiredFields = [\n  'supplier',\n  'invoice_number',\n  'invoice_date',\n  'subtotal',\n  'vat',\n  'total',\n  'currency',\n  'payment_deadline',\n];\n\nconst isMissing = (value) =>\n  value === undefined ||\n  value === null ||\n  (typeof value === 'string' && value.trim() === '');\n\nfor (const field of requiredFields) {\n  if (isMissing(data[field])) {\n    issues.push(`${field} is missing`);\n  }\n}\n\nfor (const field of ['subtotal', 'vat', 'total']) {\n  if (!isMissing(data[field])) {\n    const value = Number(data[field]);\n\n    if (!Number.isFinite(value) || value < 0) {\n      issues.push(`${field} must be a non-negative number`);\n    }\n  }\n}\n\nconst isValidDate = (value) => {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value ?? '')) return false;\n\n  const [year, month, day] = value.split('-').map(Number);\n  const date = new Date(Date.UTC(year, month - 1, day));\n\n  return (\n    date.getUTCFullYear() === year &&\n    date.getUTCMonth() === month - 1 &&\n    date.getUTCDate() === day\n  );\n};\n\nif (!isMissing(data.invoice_date) && !isValidDate(data.invoice_date)) {\n  issues.push('invoice_date must use YYYY-MM-DD');\n}\n\nif (\n  !isMissing(data.payment_deadline) &&\n  !isValidDate(data.payment_deadline)\n) {\n  issues.push('payment_deadline must use YYYY-MM-DD');\n}\n\nif (\n  isValidDate(data.invoice_date) &&\n  isValidDate(data.payment_deadline) &&\n  data.payment_deadline < data.invoice_date\n) {\n  issues.push('payment_deadline cannot be before invoice_date');\n}\n\nconst subtotal = Number(data.subtotal);\nconst vat = Number(data.vat);\nconst total = Number(data.total);\n\nif (\n  Number.isFinite(subtotal) &&\n  Number.isFinite(vat) &&\n  Number.isFinite(total) &&\n  Math.abs(subtotal + vat - total) > 0.02\n) {\n  issues.push('subtotal plus VAT does not equal total');\n}\n\nconst currency = String(data.currency ?? '').trim().toUpperCase();\n\nif (currency && !/^[A-Z]{3}$/.test(currency)) {\n  issues.push('currency must be a three-letter code');\n}\n\nreturn {\n  json: {\n    ...data,\n    currency,\n    validation_passed: issues.length === 0,\n    validation_issues: issues.join('; '),\n    status: issues.length === 0\n      ? 'Pending review'\n      : 'Validation failed',\n  },\n};"
      },
