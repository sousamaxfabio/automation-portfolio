    "item": [
        {
            "name": "Get repositories - success",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Response is an array\", function () {",
                            "    const data = pm.response.json();",
                            "    pm.expect(data).to.be.an(\"array\");",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/vnd.github+json",
                        "type": "text"
                    },
                    {
                        "key": "User-Agent",
                        "value": "github-repository-monitor",
                        "type": "text"
                    }
                ],
                "url": "{{base_url}}/users/{{username}}/repos?per_page=100&sort=updated",
                "description": "Retrieves public repositories for the configured GitHub username."
            }
        },
