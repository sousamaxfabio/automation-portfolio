      "name": "Build Classified Request"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst errors = [];\n\nconst requiredFields = [\n  'requester_name',\n  'requester_email',\n  'request_title',\n  'request_details',\n  'submitted_at',\n  'category',\n  'urgency',\n  'language',\n  'suggested_department',\n  'short_summary',\n];\n\nfor (const field of requiredFields) {\n  const value = data[field];\n\n  if (typeof value !== 'string' || value.trim() === '') {\n    errors.push(`${field} is required`);\n  }\n}\n\nconst allowedCategories = [\n  'Access',\n  'Hardware',\n  'Software',\n  'Billing',\n  'HR',\n  'Facilities',\n  'Other',\n];\n\nconst allowedUrgencies = [\n  'Low',\n  'Medium',\n  'High',\n  'Critical',\n];\n\nconst allowedDepartments = [\n  'IT',\n  'Finance',\n  'Human Resources',\n  'Facilities',\n  'Operations',\n  'Customer Support',\n];\n\nif (data.category && !allowedCategories.includes(data.category)) {\n  errors.push('category is invalid');\n}\n\nif (data.urgency && !allowedUrgencies.includes(data.urgency)) {\n  errors.push('urgency is invalid');\n}\n\nif (\n  data.suggested_department &&\n  !allowedDepartments.includes(data.suggested_department)\n) {\n  errors.push('suggested_department is invalid');\n}\n\nif (\n  typeof data.requester_email === 'string' &&\n  data.requester_email.trim() !== '' &&\n  !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data.requester_email)\n) {\n  errors.push('requester_email is invalid');\n}\n\nif (\n  typeof data.short_summary === 'string' &&\n  data.short_summary.length > 160\n) {\n  errors.push('short_summary exceeds 160 characters');\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      validation_status: errors.length === 0 ? 'valid' : 'invalid',\n      validation_errors: errors,\n    },\n  },\n];"
      },
