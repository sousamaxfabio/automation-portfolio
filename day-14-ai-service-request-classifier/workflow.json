        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You classify internal service requests.\n\nReturn exactly one valid JSON object. Do not use Markdown, code fences, or explanatory text.\n\nUse exactly these fields:\n{\n  \"category\": \"Access, Hardware, Software, Billing, HR, Facilities, or Other\",\n  \"urgency\": \"Low, Medium, High, or Critical\",\n  \"language\": \"Detected language name in English\",\n  \"suggested_department\": \"IT, Finance, Human Resources, Facilities, Operations, or Customer Support\",\n  \"short_summary\": \"One concise sentence of no more than 160 characters\"\n}\n\nUrgency rules:\n- Low: minor issue or general request with no meaningful blockage.\n- Medium: issue affects work but a workaround exists.\n- High: the requester cannot complete important work.\n- Critical: security incident, safety risk, widespread outage, or immediate severe business impact.\n\nChoose only one value for category, urgency, and suggested_department."
            },
            {
              "content": "={{ 'Classify this service request.\\n\\nTitle: ' + $json.request_title + '\\nDetails: ' + $json.request_details }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "verbosity": "low",
              "name": "service_request_classification",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Access\",\n        \"Hardware\",\n        \"Software\",\n        \"Billing\",\n        \"HR\",\n        \"Facilities\",\n        \"Other\"\n      ]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Low\",\n        \"Medium\",\n        \"High\",\n        \"Critical\"\n      ]\n    },\n    \"language\": {\n      \"type\": \"string\"\n    },\n    \"suggested_department\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"IT\",\n        \"Finance\",\n        \"Human Resources\",\n        \"Facilities\",\n        \"Operations\",\n        \"Customer Support\"\n      ]\n    },\n    \"short_summary\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"urgency\",\n    \"language\",\n    \"suggested_department\",\n    \"short_summary\"\n  ],\n  \"additionalProperties\": false\n}"
            }
          }
        }
